FROM python:3.11-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/backend-python/src:/app/backend-python \
    DATABASE_PATH=/app/data/smart_factory.db \
    ARTIFACTS_DIR=/app/models \
    LOG_LEVEL=INFO
COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir -r requirements.txt
COPY backend-python ./backend-python
COPY database ./database
COPY models ./models
RUN mkdir -p /app/data /app/models /app/reports
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "api.main:app", "--app-dir", "backend-python", "--host", "0.0.0.0", "--port", "8000"]
